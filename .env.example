# 复制为 .env 后填值：cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交真实密钥。

# ── 大语言模型：vLLM（OpenAI 兼容 /v1）───────────────────────────────
vLLM_QWEN_BASE_URL = "http://<your-host>:3791/v1"
vLLM_QWEN_API_KEY = "<your-vllm-key>"
vLLM_QWEN_MODEL_ID = "my_qwen3.8_flash_next"

# ── Embedding / Reranker：Xinference（OpenAI 兼容 /v1，另有原生 REST）──
# REST 根地址给 xinference_client 用；/v1 地址给 OpenAI 兼容客户端用
XINFERENCE_BASE_URL = "http://<your-host>:3797"
XINFERENCE_OPENAI_BASE_URL = "http://<your-host>:3797/v1"
XINFERENCE_API_KEY = "<your-xinference-key>"
XINFERENCE_EMBEDDING_MODEL_ID = "my_qwen3_embedding_0.6b"
XINFERENCE_RERANKER_MODEL_ID = "my_qwen3_reranker_0.6b"
# Qwen3-Embedding-0.6B：向量维度 1024，最大输入 32768

# ── 向量数据库：Milvus standalone（本机 Docker，Attu 面板 http://localhost:16630）
MILVUS_URI = "http://localhost:19530"
# 单机版默认不开鉴权；若开启鉴权再补 MILVUS_TOKEN = "user:password"
